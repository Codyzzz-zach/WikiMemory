{
	"name": "wge-memory",
	"version": "0.1.0",
	"description": "WGEMemory4LLM — Agent-native knowledge compilation and long-term memory layer",
	"bin": {
		"wge": "dist/index.js",
		"wge-mcp": "dist/mcp.js",
		"wge-worker": "dist/worker.js"
	},
	"type": "module",
	"engines": {
		"node": ">=20.0.0"
	},
	"scripts": {
		"dev": "tsx src/cli/index.ts",
		"mcp": "tsx src/transport/mcp/stdio.ts",
		"worker": "tsx src/workers/ingest-worker.ts",
		"economics:ingest": "node --import tsx scripts/report-ingest-economics.ts",
		"build": "tsup",
		"typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
		"lint": "biome check src scripts",
		"lint:fix": "biome check --write src scripts",
		"format": "biome format --write src",
		"test": "vitest run",
		"test:watch": "vitest",
		"pilot": "tsx scripts/pilot.ts",
		"i3:sim:gate": "node --import tsx scripts/integration-i3-sim-gate.ts",
		"i3:sim:paired": "node --import tsx scripts/integration-i3-sim-paired-review.ts",
		"c1:pure-shadow": "node --import tsx scripts/run-c1-pure-shadow.ts",
		"c1:semantic-slice-gate": "node --import tsx scripts/run-c1-semantic-slice-gate.ts",
		"c1.5:association:prepare": "node --import tsx scripts/prepare-question-association-bridge-fixture.ts",
		"c1.5:association:gate": "vitest run src/wiki/question-association-shadow.test.ts src/integration/question-association-bridge.test.ts",
		"benchmark:refine": "node --import tsx scripts/refine-benchmark-batch-a.ts",
		"benchmark:canary": "node --import tsx scripts/validate-benchmark-canary.ts",
		"benchmark:batch-b:build": "node --import tsx scripts/build-benchmark-batch-b.ts",
		"benchmark:batch-b:validate": "node --import tsx scripts/validate-benchmark-batch-b.ts",
		"benchmark:seed:validate": "node --import tsx scripts/validate-benchmark-seed.ts",
		"benchmark:e1": "node --import tsx scripts/evaluate-benchmark-e1.ts",
		"benchmark:e4:prepare": "node --import tsx scripts/prepare-benchmark-e4-smoke.ts",
		"benchmark:e4:run": "node --import tsx scripts/run-benchmark-e4-smoke.ts",
		"benchmark:e4:graph-ablation": "node --import tsx scripts/run-benchmark-e4-smoke.ts --ablation --repetitions 3",
		"benchmark:e4:batch-b:prepare": "node --import tsx scripts/prepare-benchmark-e4-smoke.ts --selection experiments/benchmark-seed-v1/e4-smoke/batch-b-remaining-selection.json --report-name e4-batch-b-remaining",
		"benchmark:e4:batch-b:run": "node --import tsx scripts/run-benchmark-e4-smoke.ts --selection experiments/benchmark-seed-v1/e4-smoke/batch-b-remaining-selection.json --report-name e4-batch-b-remaining --all-modes --repetitions 1",
		"benchmark:batch-c:freeze": "node --import tsx scripts/freeze-benchmark-batch-c-stage-a.ts",
		"benchmark:batch-c:prepare": "node --import tsx scripts/prepare-benchmark-batch-c.ts",
		"benchmark:batch-c:run": "node --import tsx scripts/run-benchmark-batch-c-blind.ts",
		"benchmark:batch-c:audit-stage-b": "node --import tsx scripts/audit-benchmark-batch-c-stage-b.ts",
		"benchmark:batch-c:normalize-stage-b": "node --import tsx scripts/normalize-benchmark-batch-c-stage-b.ts",
		"benchmark:batch-c:score": "node --import tsx scripts/score-benchmark-batch-c.ts",
		"benchmark:batch-c:evaluate-retrieval": "node --import tsx scripts/evaluate-benchmark-batch-c-retrieval.ts",
		"benchmark:s200:validate-stage-a": "node --import tsx scripts/validate-benchmark-s200-stage-a.ts",
		"benchmark:s200:freeze-stage-a": "node --import tsx scripts/freeze-benchmark-s200-stage-a.ts",
		"benchmark:s200:compile": "node --import tsx scripts/run-goal3-s200-compile.ts",
		"retrieval:aliases:generate": "node --import tsx scripts/generate-retrieval-aliases.ts",
		"benchmark:e4:rescore": "node --import tsx scripts/rescore-benchmark-e4-run.ts",
		"evolution:validate": "node --import tsx scripts/validate-evolution-dataset.ts",
		"evolution:experiment": "node --import tsx scripts/evolution-experiment.ts",
		"evolution:answers": "node --import tsx scripts/evolution-answer-pilot.ts",
		"goal3:scale": "node --import tsx scripts/run-goal3-scale-retrieval.ts",
		"goal3:index-benchmark": "node --import tsx scripts/run-goal3-index-benchmark.ts",
		"goal3:local-closure": "node --import tsx scripts/run-goal3-local-closure.ts",
		"goal3:pack-parity": "node --import tsx scripts/run-goal3-pack-parity.ts",
		"goal3:pack-cost-ledger": "node --import tsx scripts/run-goal3-pack-cost-ledger.ts",
		"goal3:structured-pack-renderer": "node --import tsx scripts/run-goal3-structured-pack-renderer.ts",
		"goal3:context-pack-transport-parity": "node --import tsx scripts/run-goal3-context-pack-transport-parity.ts"
	},
	"dependencies": {
		"@modelcontextprotocol/client": "^2.0.0",
		"@modelcontextprotocol/server": "^2.0.0",
		"commander": "^13.0.0",
		"js-yaml": "^4.3.1",
		"openai": "^4.77.0",
		"zod": "^3.25.76",
		"zod4": "npm:zod@^4.4.3"
	},
	"devDependencies": {
		"@biomejs/biome": "^1.9.0",
		"@types/js-yaml": "^4.0.9",
		"@types/node": "^22.0.0",
		"tsup": "^8.4.0",
		"tsx": "^4.19.0",
		"typescript": "^5.7.0",
		"vitest": "^3.0.0"
	}
}
