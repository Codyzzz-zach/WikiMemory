:d440754de41a0e5a-50c7b7e09026f81e","evidenceRefs":["span:s200-law-dma-005-d440754de41a0e5a-3#chars-255-306"],"knowledgeVersion":"kv:d1a30198321ea2172bb9fdb6","selectionReasons":["SOURCE_DIVERSITY","KNOWLEDGE_VERSION_DIVERSITY","STABLE_CLAIM_ORDER"],"sourceId":"source:s200-law-dma-005-d440754de41a0e5a","statement":"2023年9月，包括Alphabet、亚马逊、苹果、字节跳动、Meta、微软等企业被确认为'看门人'。"},{"claimRef":"claim:0cbb0a59d7c7bc5f-6890c8ae2cf591df","evidenceRefs":["span:s200-law-dma-006-0cbb0a59d7c7bc5f-2#chars-109-143"],"knowledgeVersion":"kv:955566069e2672db8fad3ba4","selectionReasons":["SOURCE_DIVERSITY","KNOWLEDGE_VERSION_DIVERSITY","STABLE_CLAIM_ORDER"],"sourceId":"source:s200-law-dma-006-0cbb0a59d7c7bc5f","statement":"DMA把满足特定门槛的大型在线平台指定为「守门人」（gatekeeper）。"},{"claimRef":"claim:a7aadcf11ba39143-c8ef3face8d3c85a","evidenceRefs":["span:s200-law-dma-001-a7aadcf11ba39143-5#chars-638-736"],"knowledgeVersion":"kv:d0a07fbfc36f3e791c4fcc1c","selectionReasons":["SOURCE_DIVERSITY","KNOWLEDGE_VERSION_DIVERSITY","BOUNDARY_LEXICAL_COVERAGE"],"sourceId":"source:s200-law-dma-001-a7aadcf11ba39143","statement":"The decreases in choice can confer on the provider of those services the position of a so-called gatekeeper."},{"claimRef":"claim:d440754de41a0e5a-d15930265f03e045","evidenceRefs":["span:s200-law-dma-005-d440754de41a0e5a-3#chars-183-255"],"knowledgeVersion":"kv:d1a30198321ea2172bb9fdb6","selectionReasons":["SOURCE_DIVERSITY","KNOWLEDGE_VERSION_DIVERSITY","STABLE_CLAIM_ORDER"],"sourceId":"source:s200-law-dma-005-d440754de41a0e5a","statement":"根据法案，市值750亿欧元或年营业额75亿欧元以上，且在欧盟每月至少有4500万活跃用户，每年有1万名商业用户的企业主体可以被认定为'看门人'。"}],"schemaVersion":"wge-question-identity-card/v1","scope":{"type":"GLOBAL"}}}],"decisionContract":{"canonicalMutationAllowed":false,"createQuestionAllowed":false,"manyToMany":true,"reasonCodes":["IN_BOUND_SUPPORT","IN_BOUND_CHALLENGE","IN_BOUND_CONDITION","IN_BOUND_SUPERSESSION","EXPLICIT_GAP_SIGNAL","OUT_OF_BOUNDARY","ADJACENT_QUESTION_ONLY","SOURCE_METADATA_ONLY","INSUFFICIENT_CLAIM_CON