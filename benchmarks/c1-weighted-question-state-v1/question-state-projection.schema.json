{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wikimemory.local/schemas/c1/question-state-projection-v1.json",
  "title": "C1 QuestionStateProjection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "questionRef",
    "knowledgeVersion",
    "inputClosureHash",
    "branchAssessments",
    "unresolvedFactors",
    "projectionVersion",
    "projectionHash"
  ],
  "properties": {
    "schemaVersion": {
      "const": "wge-question-state-projection/v1"
    },
    "questionRef": {
      "type": "string",
      "pattern": "^question:"
    },
    "knowledgeVersion": {
      "type": "string",
      "minLength": 1
    },
    "inputClosureHash": {
      "$ref": "#/$defs/sha256"
    },
    "branchAssessments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/branchAssessment"
      }
    },
    "unresolvedFactors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/unresolvedFactor"
      }
    },
    "projectionVersion": {
      "const": "c1-question-state-projection/v1"
    },
    "projectionHash": {
      "$ref": "#/$defs/sha256"
    }
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "knowledgeScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type"],
      "properties": {
        "type": {
          "enum": ["GLOBAL", "PERSONAL", "PROJECT"]
        },
        "id": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "const": "PROJECT"
              }
            }
          },
          "then": {
            "required": ["id"]
          }
        }
      ]
    },
    "branchScope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["knowledgeScope", "applicability"],
      "properties": {
        "knowledgeScope": {
          "$ref": "#/$defs/knowledgeScope"
        },
        "applicability": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "dimensionReason": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "dimension",
        "ordinal",
        "reasonCodes",
        "claimRefs",
        "relationIds",
        "evidenceSpanIds"
      ],
      "properties": {
        "dimension": {
          "enum": [
            "grounding",
            "authority",
            "currentness",
            "applicability",
            "relational_support",
            "uncertainty"
          ]
        },
        "ordinal": {
          "enum": ["HIGHER", "EQUAL", "LOWER", "UNKNOWN"]
        },
        "reasonCodes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "DIRECT_EVIDENCE_PRESENT",
              "CLAIM_CLOSURE_COMPLETE",
              "SAME_AUTHORITY_SUCCESSOR",
              "PEER_AUTHORITIES_EQUAL",
              "AUTHORITY_NOT_COMPARABLE",
              "EFFECTIVE_BASELINE",
              "LATER_EFFECTIVE_REPLACEMENT",
              "APPLICABILITY_MATCH",
              "APPLICABILITY_PARTIAL",
              "CONDITION_REQUIRED",
              "OUTSIDE_SUPERSESSION_SCOPE",
              "EXPLICIT_SUPERSESSION",
              "EXPLICIT_CONTRADICTION",
              "PEER_CONFLICT_UNRESOLVED",
              "NO_AUTHORIZED_DECISION",
              "INSUFFICIENT_EVIDENCE"
            ]
          }
        },
        "claimRefs": {
          "$ref": "#/$defs/claimRefs"
        },
        "relationIds": {
          "$ref": "#/$defs/relationIds"
        },
        "evidenceSpanIds": {
          "$ref": "#/$defs/evidenceSpanIds"
        }
      }
    },
    "claimRefs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^claim:"
      }
    },
    "relationIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^relation:"
      }
    },
    "evidenceSpanIds": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^span:"
      }
    },
    "branchAssessment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "branchId",
        "claimRefs",
        "standing",
        "qualifiers",
        "scope",
        "conditions",
        "dimensionReasons"
      ],
      "properties": {
        "branchId": {
          "type": "string",
          "pattern": "^branch:"
        },
        "claimRefs": {
          "allOf": [
            {
              "$ref": "#/$defs/claimRefs"
            },
            {
              "minItems": 1
            }
          ]
        },
        "standing": {
          "enum": ["LEADING", "CO_LEADING", "ALTERNATIVE", "HISTORICAL", "UNRANKED"]
        },
        "qualifiers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["CONDITIONAL", "CONTESTED", "UNRESOLVED"]
          }
        },
        "scope": {
          "$ref": "#/$defs/branchScope"
        },
        "conditions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "dimensionReasons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/dimensionReason"
          }
        }
      }
    },
    "unresolvedFactor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "factorId",
        "reasonCode",
        "description",
        "claimRefs",
        "relationIds",
        "evidenceSpanIds"
      ],
      "properties": {
        "factorId": {
          "type": "string",
          "pattern": "^unresolved:"
        },
        "reasonCode": {
          "enum": [
            "PEER_CONFLICT_UNRESOLVED",
            "NO_AUTHORIZED_DECISION",
            "INSUFFICIENT_EVIDENCE"
          ]
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "claimRefs": {
          "$ref": "#/$defs/claimRefs"
        },
        "relationIds": {
          "$ref": "#/$defs/relationIds"
        },
        "evidenceSpanIds": {
          "$ref": "#/$defs/evidenceSpanIds"
        }
      }
    }
  }
}
