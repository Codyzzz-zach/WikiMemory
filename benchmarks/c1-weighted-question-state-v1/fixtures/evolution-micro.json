  "claims": [
    {
      "id": "claim:c1-micro:t0-external-tls12",
      "statement": "External APIs must use TLS 1.2 and must not enable TLS 1.0 or TLS 1.1.",
      "authority": "安全架构组",
      "authorityClass": "POLICY_OWNER",
      "claimStatus": "EFFECTIVE",
      "effectiveFrom": "2026-01-20",
      "knowledgeScope": {"type": "GLOBAL"},
