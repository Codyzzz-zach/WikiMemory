        "service identity allowlist is active",
        "traffic does not cross public, home, or third-party cloud networks"
      ],
      "evidenceSpanIds": ["span:c1-micro:t0-internal-communication"]
    },
    {
      "id": "claim:c1-micro:t0-independent-controls",
      "statement": "Token rotation, Argon2id password storage, log redaction, and downgrade approval remain independent controls.",
      "authority": "安全架构组",
      "authorityClass": "POLICY_OWNER",
