      "conditions": [],
      "evidenceSpanIds": ["span:c1-micro:t0-external-interface"]
    },
    {
      "id": "claim:c1-micro:t0-internal-http",
      "statement": "Managed production microservices may use plaintext HTTP only inside the protected managed network.",
      "authority": "安全架构组",
      "authorityClass": "POLICY_OWNER",
      "claimStatus": "EFFECTIVE",
      "effectiveFrom": "2026-01-20",
      "knowledgeScope": {"type": "GLOBAL"},
      "applicability": ["Northstar managed production microservices"],
      "conditions": [
